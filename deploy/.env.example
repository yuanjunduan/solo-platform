# ============================================================================
#  Solo 容器部署环境变量（M7 / S5）
#  用法：cp .env.example .env 后逐项填写；docker compose 会自动读取 .env。
#  带 :? 的变量缺失会直接拒绝启动——宁愿起不来，也不要带着默认密码上线。
# ============================================================================

# ---------- 访问入口 ----------
# 控制台监听端口（nginx 反代 + 静态资源）
UI_PORT=80
# 后端 HTTP 端口：控制台已反代，通常只有巡检/第三方直连时才需要暴露
SOLO_HTTP_PORT=8080

# ---------- 宿主机与 SIP ----------
# 宿主机对设备/上级平台可达的 IP（SIP Via/Contact 用它，不能填容器 IP）
SOLO_IP=192.168.1.10
# NAT/公网部署时填公网 IP；内网直连留空
SOLO_SIP_PUBLIC_IP=
SOLO_SIP_PORT=5060
# 本平台国标编码（20 位）与域（一般前 10 位 + 0000）
SOLO_SIP_ID=34020000002000000001
SOLO_SIP_DOMAIN=3402000000
# 设备注册 Digest 密码：strong random，别用 123456
SOLO_SIP_PASSWORD=change-me-strong-sip-password

# ---------- 数据库（PostgreSQL，编排内置） ----------
POSTGRES_DB=solo_db
POSTGRES_USER=solo
POSTGRES_PASSWORD=change-me-db-password

# ---------- Redis（编排内置，默认无密码） ----------
# 不对外开放端口；若改成带密码的 Redis，这里同步填
SOLO_REDIS_PASSWORD=

# ---------- 对象存储（S3 兼容，编排外） ----------
# 同机部署可填 host.docker.internal；独立机器填实际 IP
SOLO_S3_HOST=host.docker.internal
SOLO_S3_PORT=9000
SOLO_S3_ACCESS_KEY=solo
SOLO_S3_SECRET_KEY=change-me-s3-secret
SOLO_S3_BUCKET=solo

# ---------- 流媒体 ZLMediaKit（编排外） ----------
# ZLM 管理面地址；同机 host 网络时可填 host.docker.internal
SOLO_MEDIA_HOST=host.docker.internal
# 必须与 ZLM config.ini 的 [general].mediaServerId 一致
SOLO_ZLM_SERVER_ID=zlmediakit-local
# 必须与 ZLM config.ini 的 [api].secret 一致（过短会被 ZLM 判非法并改写配置）
SOLO_ZLM_SECRET=change-me-zlm-api-secret-32chars
# 必须与 ZLM hook 回调 URL 上的 ?secret= 一致
SOLO_ZLM_HOOK_SECRET=change-me-zlm-hook-secret
# 播放地址对外的 ZLM IP/端口，留空跟随 SOLO_MEDIA_HOST:8088
SOLO_ZLM_STREAM_IP=

# ---------- 安全 ----------
# JWT 签名密钥：openssl rand -base64 48 生成，换掉默认值
SOLO_JWT_SECRET=change-me-jwt-secret-at-least-32-bytes
# 反向代理信任名单：容器内相互调用时填 Docker 网段（如 172.16.0.0/12）
OPENAPI_TRUSTED_PROXIES=127.0.0.1,::1

# ---------- JVM ----------
JAVA_OPTS=-XX:MaxRAMPercentage=70 -XX:+UseG1GC
